datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
  output   = "./dbml"
}

model Usuario {
  id            Int    @id @default(autoincrement())
  nombre        String
  usuario       String @unique
  contrasena    String
  eliminado     Boolean @default(false)
  complejos     UsuarioComplejo[]
  fechaCreacion DateTime
}

model Complejo {
  id               Int                @id @default(autoincrement())
  nombre           String
  eliminado        Boolean          @default(false)
  usuarios         UsuarioComplejo[]
  unidadReservable UnidadReservable[]

  fechaCreacion     DateTime
  usuarioCreadorId  Int
 }

 model UsuarioComplejo {
  id          Int       @id @default(autoincrement())
  usuarioId   Int
  complejoId  Int
  propietario Boolean @default(false)
  rol         Rol
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  complejo    Complejo  @relation(fields: [complejoId], references: [id])

  @@unique([usuarioId, complejoId])
 }

model UnidadReservable {
  id         Int        @id @default(autoincrement())
  nombre     String
  eliminado  Boolean    @default(false)
  tipo       String
  estado     EstadoUnidadReservable
  capacidad  Int
  complejoId Int
  complejo   Complejo   @relation(fields: [complejoId], references: [id])
  reservas   Reserva[]

  fechaCreacion     DateTime
  usuarioCreadorId  Int
}

model Reserva {
  id                    Int              @id @default(autoincrement())
  fechaInicio           DateTime
  fechaSalida           DateTime
  cantidadPersonas      Int
  estado                EstadoReserva    @default(PENDIENTE)
  plataformaProveniente PlataformaProveniente
  aclaracion            String
  eliminado             Boolean          @default(false)

  tarifaTotal           Decimal
  estadoPago            EstadoPago       @default(PENDIENTE)
  monedaPago            Moneda
  pagos                 Pago[]

  unidadReservableId    Int
  unidadReservable      UnidadReservable @relation(fields: [unidadReservableId], references: [id])
  huespedes             ReservaHuesped[]

  fechaCreacion         DateTime
  usuarioCreadorId      Int
}

model Huesped {
  id          Int              @id @default(autoincrement())
  nombre      String
  apellido    String
  procedencia String
  mail        String
  telefono    String
  descripcion String
  dni         String?
  eliminado   Boolean @default(false)
  reservas    ReservaHuesped[]

  fechaCreacion     DateTime
  usuarioCreadorId  Int
}

model ReservaHuesped {
  id        Int     @id @default(autoincrement())
  esTitular Boolean
  reservaId Int
  huespedId Int
  reserva   Reserva @relation(fields: [reservaId], references: [id])
  huesped   Huesped @relation(fields: [huespedId], references: [id])
}

model Pago {
  id           Int           @id @default(autoincrement())
  tipoPago     TipoPago
  monto        Decimal
  fecha        DateTime
  eliminado    Boolean       @default(false)
  reservaId    Int
  reserva      Reserva       @relation(fields: [reservaId], references: [id])
  comprobantes Comprobante[]

  fechaCreacion         DateTime
  usuarioCreadorId      Int
}

model Comprobante {
  id                Int      @id @default(autoincrement())
  tipoPago          TipoPago
  eliminado         Boolean  @default(false)

  pagoId            Int
  pago              Pago     @relation(fields: [pagoId], references: [id])

  fechaCreacion     DateTime
  usuarioCreadorId  Int
}

enum TipoPago {
  SEÑA
  PAGO_FINAL
  REEMBOLSO
}

enum Moneda {
  ARS
  USD
  EUR
  BRL
  PESO
}

enum Rol {
  ADMIN
  VIEW
}

enum EstadoUnidadReservable {
  DISPONIBLE
  OCUPADO
  INHABILITADO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  COMPLETADA
  CANCELADA
}

enum PlataformaProveniente {
  BOOKING
  PAGINA_WEB
  AIRBNB
  REFERIDO
  CONOCIDO
  OTRO
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  COMPLETADO
}